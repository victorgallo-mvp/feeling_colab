RESEND_API_KEY=
MAIL_FROM=Reconhecimento <onboarding@resend.dev>
# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
